// Cashflow Publimatec — Tesorería operativa multi-entidad.
// IMPORTANTE: este archivo define los tipos de Prisma. Los cambios de esquema en la
// base se aplican con los SQL idempotentes de prisma/migrations/*.sql (nunca con db push).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum AccountType {
  BANK
  CASH
  WALLET
  CREDIT_CARD
}

enum Direction {
  IN
  OUT
}

enum ObligationStatus {
  OPEN
  PARTIAL
  SETTLED
  CANCELLED
}

enum Priority {
  FIXED
  FLEXIBLE
}

enum Frequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

enum MovementType {
  OPENING
  PAYMENT
  ADJUSTMENT
  TRANSFER
  CARD_PAYMENT
}

enum TransferKind {
  LOAN
  CONTRIBUTION
  TRANSFER
}

enum TransferStatus {
  PLANNED
  EXECUTED
  CANCELLED
}

enum CounterpartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum StagingStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  name         String
  passwordHash String
  role         Role               @default(USER)
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  entityAccess UserEntityAccess[]
}

model UserEntityAccess {
  userId   String
  entityId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([userId, entityId])
}

model AppSetting {
  id                Int       @id @default(1)
  reportingCurrency String    @default("HNL")
  timezone          String    @default("America/Tegucigalpa")
  fxBankSpread      Decimal   @default(0.18) @db.Decimal(10, 4)
  fxLastSyncAt      DateTime?
  fxLastSyncError   String?
  updatedAt         DateTime  @updatedAt
}

model Entity {
  id               String    @id @default(uuid())
  name             String
  currency         String    @default("HNL")
  color            String    @default("#10b981")
  minCashThreshold Decimal   @default(0) @db.Decimal(18, 2)
  isDefault        Boolean   @default(false)
  /// Orden visual en menú y ajustes (la Base siempre va primero)
  sortOrder        Int       @default(0)
  archivedAt       DateTime?
  webhookTokenHash String?   @unique
  webhookTokenHint String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  userAccess       UserEntityAccess[]
  accounts         Account[]
  counterparties   Counterparty[]
  categories       Category[]
  obligations      Obligation[]
  movements        CashMovement[]
  recurringRules   RecurringRule[]
  stagingItems     StagingItem[]
  transfersOut     InterEntityTransfer[] @relation("TransferFrom")
  transfersIn      InterEntityTransfer[] @relation("TransferTo")
  cardCharges      CardCharge[]
  cardInstallments CardInstallment[]
  cardPayments     CardPayment[]
  accountTransfers AccountTransfer[]
}

model ExchangeRate {
  id                String   @id @default(uuid())
  fromCurrency      String
  toCurrency        String
  rate              Decimal  @db.Decimal(18, 6)
  effectiveDate     DateTime @db.Date
  // Tipo de cambio diario USD→HNL (tarjetas): oficial + spread bancario = venta efectiva
  officialBuyRate   Decimal? @db.Decimal(10, 4)
  officialSellRate  Decimal? @db.Decimal(10, 4)
  bankSpread        Decimal? @db.Decimal(10, 4)
  effectiveSellRate Decimal? @db.Decimal(10, 4)
  source            String?
  updatedAt         DateTime @default(now()) @updatedAt
  createdAt         DateTime @default(now())

  @@unique([fromCurrency, toCurrency, effectiveDate])
}

model Account {
  id                      String            @id @default(uuid())
  entityId                String
  name                    String
  type                    AccountType       @default(BANK)
  institution             String?
  archivedAt              DateTime?
  // Solo tarjetas de crédito (CREDIT_CARD)
  creditLimit             Decimal?          @db.Decimal(18, 2)
  statementDay            Int?
  paymentDueDay           Int?
  defaultPaymentAccountId String?
  /// Tarjeta bimoneda: segunda moneda ('USD' en entidades HNL)
  foreignCurrency         String?
  creditLimitForeign      Decimal?          @db.Decimal(18, 2)
  customSellRate          Decimal?          @db.Decimal(10, 4)
  cycleBudget             Decimal?          @db.Decimal(18, 2)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  entity                  Entity            @relation(fields: [entityId], references: [id], onDelete: Restrict)
  movements               CashMovement[]
  payments                Payment[]
  defaultPaymentAccount   Account?          @relation("CardDefaultPayment", fields: [defaultPaymentAccountId], references: [id], onDelete: SetNull)
  paysCards               Account[]         @relation("CardDefaultPayment")
  cardCharges             CardCharge[]
  cardInstallments        CardInstallment[]
  cardPayments            CardPayment[]     @relation("CardPaymentCard")
  cardPaymentsFrom        CardPayment[]     @relation("CardPaymentFrom")
  transfersOut            AccountTransfer[] @relation("AccountTransferFrom")
  transfersIn             AccountTransfer[] @relation("AccountTransferTo")

  @@index([entityId])
}

model CashMovement {
  id                String               @id @default(uuid())
  entityId          String
  accountId         String
  type              MovementType
  amount            Decimal              @db.Decimal(18, 2) // con signo: + entra, - sale
  currency          String? // NULL = moneda de la entidad (solo tarjetas usan otra)
  date              DateTime             @db.Date
  description       String?
  transferId        String?
  /// Transferencia entre cuentas de la misma entidad
  accountTransferId String?
  createdById       String?
  createdAt         DateTime             @default(now())
  entity            Entity               @relation(fields: [entityId], references: [id], onDelete: Restrict)
  account           Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transfer          InterEntityTransfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)
  accountTransfer   AccountTransfer?     @relation(fields: [accountTransferId], references: [id], onDelete: SetNull)
  payment           Payment?
  cardCharge        CardCharge?
  cardPaymentBank   CardPayment?         @relation("CardPaymentBankMovement")
  cardPaymentCard   CardPayment?         @relation("CardPaymentCardMovement")

  @@index([entityId, date])
  @@index([accountId])
  @@index([transferId])
  @@index([accountTransferId])
}

model Counterparty {
  id          String           @id @default(uuid())
  entityId    String
  name        String
  type        CounterpartyType @default(BOTH)
  externalRef String?
  createdAt   DateTime         @default(now())
  entity      Entity           @relation(fields: [entityId], references: [id], onDelete: Restrict)
  obligations Obligation[]
  rules       RecurringRule[]
  cardCharges CardCharge[]

  @@index([entityId])
}

model Category {
  id          String          @id @default(uuid())
  entityId    String
  name        String
  direction   Direction
  color       String?
  createdAt   DateTime        @default(now())
  entity      Entity          @relation(fields: [entityId], references: [id], onDelete: Restrict)
  obligations Obligation[]
  rules       RecurringRule[]
  cardCharges CardCharge[]

  @@index([entityId])
}

model Obligation {
  id             String               @id @default(uuid())
  entityId       String
  direction      Direction
  description    String
  amount         Decimal              @db.Decimal(18, 2)
  dueDate        DateTime             @db.Date
  expectedDate   DateTime             @db.Date
  status         ObligationStatus     @default(OPEN)
  priority       Priority             @default(FLEXIBLE)
  isHypothetical Boolean              @default(false)
  counterpartyId String?
  categoryId     String?
  recurrenceId   String?
  occurrenceDate DateTime?            @db.Date
  transferId     String?
  stagingItemId  String?              @unique
  notes          String?
  /// Fecha en que se hizo el gasto que se reembolsa (la fecha esperada es la del reembolso)
  expenseDate    DateTime?            @db.Date
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  entity         Entity               @relation(fields: [entityId], references: [id], onDelete: Restrict)
  counterparty   Counterparty?        @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  category       Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurrence     RecurringRule?       @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  transfer       InterEntityTransfer? @relation(fields: [transferId], references: [id], onDelete: Cascade)
  payments       Payment[]
  overrides      ScenarioOverride[]
  cardCharge     CardCharge?

  @@unique([recurrenceId, occurrenceDate])
  @@index([entityId, status, expectedDate])
  @@index([transferId])
}

model Payment {
  id             String        @id @default(uuid())
  obligationId   String
  /// NULL solo en abonos históricos (no movieron caja)
  accountId      String?
  amount         Decimal       @db.Decimal(18, 2) // siempre positivo
  date           DateTime      @db.Date
  /// NULL solo en abonos históricos (no movieron caja)
  cashMovementId String?       @unique
  /// Registro histórico: baja el saldo de la partida sin mover caja
  isHistorical   Boolean       @default(false)
  note           String?
  createdById    String?
  createdAt      DateTime      @default(now())
  obligation     Obligation    @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  account        Account?      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  cashMovement   CashMovement? @relation(fields: [cashMovementId], references: [id], onDelete: Restrict)

  @@index([obligationId])
}

model RecurringRule {
  id             String        @id @default(uuid())
  entityId       String
  direction      Direction
  description    String
  amount         Decimal       @db.Decimal(18, 2)
  frequency      Frequency
  startDate      DateTime      @db.Date
  endDate        DateTime?     @db.Date
  priority       Priority      @default(FLEXIBLE)
  counterpartyId String?
  categoryId     String?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  entity         Entity        @relation(fields: [entityId], references: [id], onDelete: Restrict)
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  occurrences    Obligation[]

  @@index([entityId])
}

model InterEntityTransfer {
  id               String               @id @default(uuid())
  kind             TransferKind         @default(TRANSFER)
  status           TransferStatus       @default(PLANNED)
  fromEntityId     String
  toEntityId       String
  fromAccountId    String?
  toAccountId      String?
  amountFrom       Decimal              @db.Decimal(18, 2)
  amountTo         Decimal              @db.Decimal(18, 2)
  expectedDate     DateTime             @db.Date
  executedDate     DateTime?            @db.Date
  description      String?
  /// Esta transferencia es la DEVOLUCIÓN (por abonos) del préstamo indicado
  repaymentOfId    String?              @unique
  /// Interés incluido en la devolución, en la moneda de quien prestó (0 = sin interés)
  interestAmount   Decimal              @default(0) @db.Decimal(18, 2)
  /// Reembolso de un gasto de la unidad origen pagado con tarjeta de la unidad destino (se paga por abonos)
  isReimbursement  Boolean              @default(false)
  createdById      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  fromEntity       Entity               @relation("TransferFrom", fields: [fromEntityId], references: [id], onDelete: Restrict)
  toEntity         Entity               @relation("TransferTo", fields: [toEntityId], references: [id], onDelete: Restrict)
  repaymentOf      InterEntityTransfer? @relation("LoanRepayment", fields: [repaymentOfId], references: [id], onDelete: SetNull)
  repayment        InterEntityTransfer? @relation("LoanRepayment")
  reimbursedCharge CardCharge?          @relation("ChargeReimbursement")
  obligations      Obligation[]
  movements        CashMovement[]

  @@index([fromEntityId])
  @@index([toEntityId])
}

/// Transferencia entre cuentas líquidas de UNA misma entidad. Se ejecuta al momento
/// (dos CashMovement TRANSFER espejo); no genera partidas proyectadas.
model AccountTransfer {
  id            String         @id @default(uuid())
  entityId      String
  fromAccountId String
  toAccountId   String
  amount        Decimal        @db.Decimal(18, 2)
  date          DateTime       @db.Date
  status        TransferStatus @default(EXECUTED)
  description   String?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  entity        Entity         @relation(fields: [entityId], references: [id], onDelete: Restrict)
  fromAccount   Account        @relation("AccountTransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount     Account        @relation("AccountTransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  movements     CashMovement[]

  @@index([entityId, date])
}

model Scenario {
  id        String             @id @default(uuid())
  name      String
  isDefault Boolean            @default(false)
  createdAt DateTime           @default(now())
  overrides ScenarioOverride[]
}

model ScenarioOverride {
  id           String     @id @default(uuid())
  scenarioId   String
  obligationId String
  expectedDate DateTime?  @db.Date
  amount       Decimal?   @db.Decimal(18, 2)
  excluded     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  scenario     Scenario   @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  obligation   Obligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, obligationId])
}

model StagingItem {
  id           String        @id @default(uuid())
  entityId     String
  source       String?
  externalId   String?
  direction    Direction?
  description  String?
  amount       Decimal?      @db.Decimal(18, 2)
  dueDate      DateTime?     @db.Date
  expectedDate DateTime?     @db.Date
  counterparty String?
  currency     String?
  cardHint     String?
  payload      Json
  status       StagingStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  receivedAt   DateTime      @default(now())
  entity       Entity        @relation(fields: [entityId], references: [id], onDelete: Restrict)

  @@unique([entityId, source, externalId])
  @@index([entityId, status])
}

// ---- Tarjetas de crédito (cuenta puente) ----

model CardCharge {
  id                      String               @id @default(uuid())
  entityId                String
  cardAccountId           String
  purchaseDate            DateTime             @db.Date
  description             String
  amount                  Decimal              @db.Decimal(18, 2)
  installments            Int                  @default(1)
  categoryId              String?
  counterpartyId          String?
  obligationId            String?              @unique
  movementId              String               @unique
  isOpening               Boolean              @default(false)
  openingKind             String? // NULL/STATEMENT = saldo al corte; UNBILLED = consumos después del corte
  currency                String? // NULL = moneda de la entidad
  exchangeRateAtTx        Decimal?             @db.Decimal(10, 4)
  amountBase              Decimal?             @db.Decimal(18, 2)
  createdById             String?
  createdAt               DateTime             @default(now())
  entity                  Entity               @relation(fields: [entityId], references: [id], onDelete: Restrict)
  card                    Account              @relation(fields: [cardAccountId], references: [id], onDelete: Restrict)
  category                Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  counterparty            Counterparty?        @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  obligation              Obligation?          @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  movement                CashMovement         @relation(fields: [movementId], references: [id], onDelete: Restrict)
  /// El consumo corresponde a este reembolso: el gasto se clasifica en la unidad que reembolsa
  reimbursementTransferId String?              @unique
  reimbursementTransfer   InterEntityTransfer? @relation("ChargeReimbursement", fields: [reimbursementTransferId], references: [id], onDelete: SetNull)
  installmentRows         CardInstallment[]

  @@index([entityId])
  @@index([cardAccountId, purchaseDate])
}

model CardInstallment {
  id            String                  @id @default(uuid())
  chargeId      String
  entityId      String
  cardAccountId String
  number        Int
  count         Int
  amount        Decimal                 @db.Decimal(18, 2)
  settledAmount Decimal                 @default(0) @db.Decimal(18, 2)
  currency      String?
  statementDate DateTime                @db.Date
  dueDate       DateTime                @db.Date
  charge        CardCharge              @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  entity        Entity                  @relation(fields: [entityId], references: [id], onDelete: Restrict)
  card          Account                 @relation(fields: [cardAccountId], references: [id], onDelete: Restrict)
  allocations   CardPaymentAllocation[]

  @@index([cardAccountId, dueDate])
  @@index([entityId])
  @@index([chargeId])
}

model CardPayment {
  id             String                  @id @default(uuid())
  entityId       String
  cardAccountId  String
  fromAccountId  String
  amount         Decimal                 @db.Decimal(18, 2)
  date           DateTime                @db.Date
  bankMovementId String                  @unique
  cardMovementId String                  @unique
  note           String?
  currency       String? // moneda del tramo (NULL = moneda de la entidad)
  bankAmount     Decimal?                @db.Decimal(18, 2)
  fxRateApplied  Decimal?                @db.Decimal(10, 4)
  fxDifference   Decimal                 @default(0) @db.Decimal(18, 2)
  groupId        String?
  createdById    String?
  createdAt      DateTime                @default(now())
  entity         Entity                  @relation(fields: [entityId], references: [id], onDelete: Restrict)
  card           Account                 @relation("CardPaymentCard", fields: [cardAccountId], references: [id], onDelete: Restrict)
  fromAccount    Account                 @relation("CardPaymentFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  bankMovement   CashMovement            @relation("CardPaymentBankMovement", fields: [bankMovementId], references: [id], onDelete: Restrict)
  cardMovement   CashMovement            @relation("CardPaymentCardMovement", fields: [cardMovementId], references: [id], onDelete: Restrict)
  allocations    CardPaymentAllocation[]

  @@index([cardAccountId])
}

model CardPaymentAllocation {
  paymentId     String
  installmentId String
  amount        Decimal         @db.Decimal(18, 2)
  payment       CardPayment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  installment   CardInstallment @relation(fields: [installmentId], references: [id], onDelete: Restrict)

  @@id([paymentId, installmentId])
  @@index([installmentId])
}
