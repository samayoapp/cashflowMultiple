# Copia este archivo a .env y completa los valores. .env NUNCA se sube a Git.
# Genera secretos con:  openssl rand -base64 48

# --- Base de datos (contenedor cashflow_db) ---
POSTGRES_USER=cashflow_user
POSTGRES_PASSWORD=CAMBIAR_password_largo_y_aleatorio
POSTGRES_DB=cashflow_publimatec

# --- Puertos del host ---
APP_HOST_PORT=3020
DB_HOST_PORT=5440

# --- Seguridad ---
# Mínimo 32 caracteres. Si cambia, todas las sesiones se cierran.
JWT_SECRET=CAMBIAR_secreto_aleatorio_de_al_menos_32_caracteres
# true cuando la app se sirva por HTTPS (cookies solo por HTTPS)
COOKIE_SECURE=false

# --- Administrador inicial (solo se usa si no existe ningún usuario) ---
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=CAMBIAR_minimo_10_caracteres
ADMIN_NAME=Administrador

# --- General ---
REPORTING_CURRENCY=HNL
APP_URL=http://localhost:3020

# --- Correo (opcional, para notificaciones futuras) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Solo para comandos locales fuera de Docker (npm run seed:demo, db:migrate) ---
DATABASE_URL=postgresql://cashflow_user:CAMBIAR_password_largo_y_aleatorio@localhost:5440/cashflow_publimatec?schema=public
